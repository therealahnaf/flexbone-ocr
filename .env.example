# Upload validation
OCR_MAX_FILE_SIZE_BYTES=10485760
OCR_MAX_IMAGE_PIXELS=25000000

# Per-process cache
OCR_CACHE_TTL_SECONDS=600
OCR_CACHE_MAX_ENTRIES=256

# Per-process client rate limit
OCR_RATE_LIMIT_REQUESTS=30
OCR_RATE_LIMIT_WINDOW_SECONDS=60

# Google Vision and batch processing
OCR_VISION_TIMEOUT_SECONDS=15
OCR_BATCH_MAX_FILES=5
OCR_BATCH_CONCURRENCY=3
